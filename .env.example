DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Required CSRF signing secret, not a login credential. Generate 32 random bytes:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=""
# React development origin. Exact origins only, no trailing slash or wildcard.
CORS_ORIGINS="http://localhost:5173"
# Empty locally; use 127.0.0.1,::1 with the same-host HTTPS Caddy proxy.
TRUSTED_PROXIES=""
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT=300
WRITE_RATE_LIMIT=60
# Shared register/login request budget per client IP and window.
AUTH_RATE_LIMIT=10

# Dedicated disposable database with all migrations applied.
TEST_DATABASE_URL=""
# Initial administrator is provisioned by npm run admin:bootstrap.
# Supply BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD in the shell or secret manager.
# Do not save bootstrap passwords in source control.
